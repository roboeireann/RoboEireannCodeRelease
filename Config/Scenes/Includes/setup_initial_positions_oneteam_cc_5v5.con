# -----------------------------------------------------------------------------
# Move robots to appropriate initial positions for Champions Cup 5v5
# NOTE: This file should be modified if setupPoses.cfg in ChampionsCup-5v5
#       scenario+location is changed
# -----------------------------------------------------------------------------

# mvrp x_mm y_mm z_mm, z_mm=330 for standing robot
#               rotx_deg=0 roty_deg=0 rotz=180 to face goal on RHS
#
# Note: positive x points to left goal, negative x is closer to right goal


robot robot1
mvrp 3900 -3000 330 0 0 90

robot robot3
mvrp 1750 -3000 330 0 0 90

robot robot5
mvrp 750 -3000 330 0 0 90

robot robot4
mvrp 1750 3000 330 0 0 -90

robot robot2
mvrp 2850 3000 330 0 0 -90


