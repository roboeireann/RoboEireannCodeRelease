<Simulation>

  <Compound name="field">

    <BoxGeometry width="10m" height="0.2m" depth="13m" color="rgb(80, 80, 80)">
      <Translation z="-0.1m" />
      <Material name="fieldCarpet" />
    </BoxGeometry>
    <BoxGeometry width="0.1m" height="0.3m" depth="13m" color="rgb(80, 80, 80)">
      <Translation y="-5.05m" z="0.15m" />
    </BoxGeometry>
    <BoxGeometry width="0.1m" height="0.3m" depth="13m" color="rgb(80, 80, 80)">
      <Translation y="5.05m" z="0.15m" />
    </BoxGeometry>
    <BoxGeometry width="10m" height="0.3m" depth="0.1m" color="rgb(80, 80, 80)">
      <Translation x="-6.55m" z="0.15m" />
    </BoxGeometry>
    <BoxGeometry width="10m" height="0.3m" depth="0.1m" color="rgb(80, 80, 80)">
      <Translation x="6.55m" z="0.15m" />
    </BoxGeometry>

    <!-- Call: new grass background texture and line textures from Field 2026M -->
    <ComplexAppearance ref="fieldGrass">
      <Translation z="-0.002" />
    </ComplexAppearance>
    <ComplexAppearance ref="fieldPatches">
      <Translation z="-0.001" />
    </ComplexAppearance>

    <Compound ref="paintedLines" />

    <!-- S-field has no corner arcs (Rules Table 2: L = none) -->

    <Compound ref="fieldGoal" name="Goal1">
      <Translation x="-4525mm" />
      <Set name="color" value="goalWhite" />
    </Compound>
    <Compound ref="fieldGoal" name="Goal2">
      <Translation x="4525mm" />
      <Rotation z="180degree" />
      <Set name="color" value="goalWhite" />
    </Compound>

  </Compound>

  <Compound name="fieldGoal">

    <CylinderGeometry height="1300mm" radius="50mm" name="post1">
      <Translation y="-925mm" z="650mm" />
    </CylinderGeometry>
    <CylinderGeometry height="1300mm" radius="50mm" name="post2">
      <Translation y="925mm" z="650mm" />
    </CylinderGeometry>

    <CylinderAppearance height="1350mm" radius="50mm" name="post1">
      <Translation y="-925mm" z="675mm" />
      <Surface ref="$color" />
    </CylinderAppearance>
    <CylinderAppearance height="1350mm" radius="50mm" name="post2">
      <Translation y="925mm" z="675mm" />
      <Surface ref="$color" />
    </CylinderAppearance>
    <CapsuleAppearance height="1950mm" radius="50mm" name="crossbar">
      <Rotation x="90degree" />
      <Translation z="1300mm" />
      <Surface ref="$color" />
    </CapsuleAppearance>

    <BoxAppearance depth="530mm" width="20mm" height="20mm" name="netSupport1">
      <Surface ref="goalWhite" />
      <Translation x="-265mm" y="925mm" z="1290mm" />
    </BoxAppearance>
    <BoxAppearance depth="530mm" width="20mm" height="20mm" name="netSupport1b">
      <Surface ref="goalWhite" />
      <Translation x="-265mm" y="925mm" z="10mm" />
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="20mm" height="1260mm" name="netSupport1c">
      <Surface ref="goalWhite" />
      <Translation x="-520mm" y="925mm" z="650mm" />
    </BoxAppearance>
    <BoxAppearance depth="530mm" width="20mm" height="20mm" name="netSupport2">
      <Surface ref="goalWhite" />
      <Translation x="-265mm" y="-925mm" z="1290mm" />
    </BoxAppearance>
    <BoxAppearance depth="530mm" width="20mm" height="20mm" name="netSupport2b">
      <Surface ref="goalWhite" />
      <Translation x="-265mm" y="-925mm" z="10mm" />
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="20mm" height="1260mm" name="netSupport2c">
      <Surface ref="goalWhite" />
      <Translation x="-520mm" y="-925mm" z="650mm" />
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="1830mm" height="20mm" name="netSupportQ">
      <Surface ref="goalWhite" />
      <Translation x="-520mm" y="0mm" z="1290mm" />
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="1830mm" height="20mm" name="netSupportQb">
      <Surface ref="goalWhite" />
      <Translation x="-520mm" y="0mm" z="10mm" />
    </BoxAppearance>
    <ComplexAppearance ref="fieldNet" />

    <BoxGeometry width="1850mm" height="0.2m" depth="0.01m">
      <Translation x="-530mm" z="0.1m" />
    </BoxGeometry>
    <BoxGeometry width="0.01mm" height="0.2m" depth="530mm">
      <Translation x="-265mm" y="-925mm" z="0.1m" />
    </BoxGeometry>
    <BoxGeometry width="0.01mm" height="0.2m" depth="530mm">
