        0.3927 0      0.3927 1
    </TexCoords>
    <Quads>
      0 1 3 2  2 3 5 4  4 5 7 6  6 7 9 8  
      8 9 11 10  10 11 13 12  12 13 15 14  14 15 17 16  
      16 17 19 18  18 19 21 20  20 21 23 22  22 23 25 24  
      24 25 27 26  26 27 29 28  28 29 31 30  30 31 33 32
    </Quads>
  </ComplexAppearance>

  <Compound name="fieldCornerArcs">
    <!-- Left-End, Right-Side -->
    <Compound>
      <Translation x="7.0m" y="4.5m" z="0.002m"/>
      <Rotation z="180degree"/>
      <ComplexAppearance ref="fieldCornerArc"/>
    </Compound>

    <!-- Left-End, Left-Side -->
    <Compound>
      <Translation x="7.0m" y="-4.5m" z="0.002m"/>
      <Rotation z="90degree"/>
      <ComplexAppearance ref="fieldCornerArc"/>
    </Compound>

    <!-- Right-End, Right-Side -->
    <Compound>
      <Translation x="-7.0m" y="4.5m" z="0.002m"/>
      <Rotation z="270degree"/>
      <ComplexAppearance ref="fieldCornerArc"/>
    </Compound>

    <!-- Right-End, Left-Side -->
    <Compound>
      <Translation x="-7.0m" y="-4.5m" z="0.002m"/>
      <ComplexAppearance ref="fieldCornerArc"/>
    </Compound>
  </Compound>



  <!-- fieldCross is available if needed but for now we use circular marks -->
  <Vertices name="fieldCross">
# cross center line
0.05 0.025 0
0.05 -0.025 0
-0.05 0.025 0
-0.05 -0.025 0

# left cross
0.025 0.05 0
0.025 0.025 0
-0.025 0.05 0
-0.025 0.025 0

# right cross
0.025 -0.05 0
0.025 -0.025 0
-0.025 -0.05 0
-0.025 -0.025 0
  </Vertices>


  <ComplexAppearance name="fieldCross">
    <Surface ref="fieldWhite"/>
    <Vertices ref="fieldCross"/>
    <Quads>
2 3 1 0
6 7 5 4
8 9 11 10
    </Quads>
  </ComplexAppearance>



  <Surface name="fieldWhite" diffuseColor="rgb(100%, 100%, 100%)" specularColor="rgb(80%, 80%, 80%)" 
           shininess="10" diffuseTexture="../Textures/shadow_frizzle.png"/>
  <Surface name="goalWhite" diffuseColor="rgb(70%, 70%, 70%)" ambientColor="rgb(45%, 45%, 45%)" 
           specularColor="rgb(40%, 40%, 40%)" shininess="30"/>
  <Surface name="goalBlack" diffuseColor="rgb(5%, 5%, 5%)" ambientColor="rgb(10%, 10%, 10%)" 
           specularColor="rgb(60%, 60%, 60%)" shininess="60"/>
  <!-- aliases -->
  <Surface name="goalColor" ref="goalWhite"/>
  <Surface name="goalNetBaseColor" ref="goalBlack"/>

</Simulation>
