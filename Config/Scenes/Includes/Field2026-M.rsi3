  <!-- 1. Define the Arc Mesh (Paste script output here) -->
  <ComplexAppearance name="fieldCornerArc">
    <Surface ref="lineColor"/>
    <Vertices>
        0.4750   0.0000 0      0.5250   0.0000 0
        0.4727   0.0466 0      0.5225   0.0515 0
        0.4659   0.0927 0      0.5149   0.1024 0
