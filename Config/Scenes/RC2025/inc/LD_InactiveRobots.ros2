<Simulation>

  <Include href="Includes/NaoV6H25.rsi2"/>
  <Include href="Includes/4_Inactives.rsi2"/>
  <Include href="Includes/Ball2016SPL.rsi2"/>
  <Include href="Includes/Field2020SPL.rsi2"/>

  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.012" color="rgb(65%, 65%, 70%)" ERP="0.8" CFM="0.001" contactSoftERP="0.2" contactSoftCFM="0.005">
    <Light z="9m" ambientColor="rgb(50%, 50%, 50%)"/>

    <Compound name="teamColors">
      <Appearance name="green"/>
      <Appearance name="red"/>
    </Compound>

    <Compound ref="robots"/>
    <Compound ref="extras">

    <Body ref="NaoDummy" name="robot1">
      <Translation x="3200mm" y="0mm" z="320mm"/>
      <Rotation z="90degree"/>
      <Set name="NaoColor" value="green"/>
    </Body>
    <Body ref="NaoDummy" name="robot2">
      <Translation x="3900mm" y="-1100mm" z="320mm"/>
      <Rotation z="0degree"/>
      <Set name="NaoColor" value="green"/>
    </Body>
    <Body ref="NaoDummy" name="robot3">
      <Translation x="3900mm" y="1100mm" z="320mm"/>
      <Rotation z="0degree"/>
      <Set name="NaoColor" value="green"/>
    </Body>
    <Body ref="NaoDummy" name="robot4">
      <Translation x="2850mm" y="-2000mm" z="320mm"/>
      <Rotation z="90degree"/>
      <Set name="NaoColor" value="green"/>
    </Body>

    </Compound>

    <Compound name="balls">
      <Body ref="ball">
        <Translation z="1m"/>
      </Body>
    </Compound>

    <Compound ref="field"/>

  </Scene>
</Simulation>
