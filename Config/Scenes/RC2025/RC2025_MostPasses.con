cs RC2025-MostPasses

# call Includes/PerceptOracle
call Includes/Normal
call Includes/Views

dr debugDrawing3d:representation:RobotPose
dr debugDrawing3d:representation:GameInfo:player

ar placePlayers off
ar penalizeIllegalPosition off
ar penalizeIllegalPositionInSet off
ar switchToSet off
ar switchToPlaying off
ar placeBall off

robot all

vfd worldState behaviour:MostPassesTeamCoordination
vfd worldState representation:ActiveTactic
vfd worldState representation:TeamBallModel
vfd worldState module:TeammatesLocator

dr debugDrawing3d:representation:SentTeamMessage2025
dr debugDrawing3d:behaviour:TeamBehaviourStatus:ballPlayer

# robot relative
vfd worldState cognition:RobotPose

vfd worldState representation:BallModel:endPosition
vfd worldState representation:FieldBall:relative

# end robot relative
vfd worldState cognition:Reset


dr annotation
vd representation:TeamBehaviorStatus
vd representation:TeamData 
vd representation:ActiveTactic


robot robot2
echo -- optionally switch the ball to the other side to verify that way too
echo call RC2025/inc/most_passes_switch_ball




