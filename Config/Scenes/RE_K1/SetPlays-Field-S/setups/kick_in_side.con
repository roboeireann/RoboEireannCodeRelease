# Set the robots in a kick in from the side state for 2v3 scenario

# mvrp x_mm y_mm z_mm, z_mm=525 for standing robot
#               rotx_deg=0 roty_deg=0 rotz=180 to face goal on RHS
# Notes:
# - positive x points to left goal, negative x is closer to right goal
# - robot pos to front of foot is 114 mm
# - robot pos to back of foot is 48 mm

# -----------------------------------------------------------------
# green/white team positions - coords relative to defending half

#robot robot1 robot2
#pr requestForPickup

robot robot3
mvrp 1000 2000 525 0 0 180

robot robot4
mvrp -1600 1400 525 0 0 90

robot robot5
mvrp -500 2200 525 0 0 135


# -----------------------------------------------------------------
# red/blue team positions

robot robot21
mvrp -4300 0 525 0 0 15

robot robot22
mvrp -3080 950 525 0 0 45

robot robot23
mvrp -3450 1250 525 0 0 45

robot robot24
mvrp -1900 2700 525 0 0 15

# robot robot25
# pr requestForPickup

# -----------------------------------------------------------------
# move the ball for robot24 to kick out
mvb -1500 2900 1000

# -----------------------------------------------------------------
# Set GameState
gc playing

# make robot24 kick the ball straight out
robot robot24
dr behaviour:StrikerPlayingTask:kickStraightAhead

# gc kickInForFirstTeam

robot robot5

