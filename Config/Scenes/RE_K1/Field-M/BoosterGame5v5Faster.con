call ../../Includes/BoosterPerceptOracle
call ../../Includes/5vs5

# without this, the simulated GC defaults to 3 active players per team (competitionTypeMiddleFoundation)
# and players 4/5 end up penalised/substitute
gc competitionTypeMiddleAdvanced

# this forces the robots to be positioned where setupPoses.cfg specifies
dr representation:SetupPoses:place
