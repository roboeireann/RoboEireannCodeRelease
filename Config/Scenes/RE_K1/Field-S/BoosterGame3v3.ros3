<Simulation>

  <Include href="../../Includes/K1/K1_new.rsi3"/>
  <Include href="../../Includes/BallFifa1.rsi3"/>
  <Include href="../../Includes/Field2026-S.rsi3"/>

  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.002" color="rgb(65%, 65%, 70%)">
    <PointLight z="9m" ambientColor="rgb(50%, 50%, 50%)"/>

    <Compound name="robots">
      <Body ref="K1" name="robot1">
        <Translation x="4" y="-3" z="525mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="white"/>
      </Body>
      <Body ref="K1" name="robot2">
        <Translation x="3" y="-3" z="525mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="green"/>
      </Body>
      <Body ref="K1" name="robot3">
        <Translation x="2" y="-3" z="525mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="green"/>
      </Body>

      <Body ref="K1" name="robot21">
        <Translation x="-4" y="3" z="525mm"/>
        <Rotation z="90degree"/>
        <Set name="TeamColor" value="blue"/>
      </Body>
      <Body ref="K1" name="robot22">
        <Translation x="-3" y="3" z="525mm"/>
        <Rotation z="90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>
      <Body ref="K1" name="robot23">
        <Translation x="-2" y="3" z="525mm"/>
        <Rotation z="90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>
    </Compound>

    <Compound name="teams">
      <Compound name="RoboEireann">
        <Compound name="17"/>
        <Compound name="green"/>
        <Compound name="white"/>
      </Compound>
      <Compound name="B-Team">
        <Compound name="70"/>
        <Compound name="red"/>
        <Compound name="blue"/>
      </Compound>
    </Compound>

    <Compound name="extras"/>

    <Compound name="balls">
      <Body ref="ball">
        <Translation z="1m"/>
      </Body>
    </Compound>

    <Compound ref="field"/>

    <Compound name="scenarios">
      <Compound name="RC2026-3v3"/>
    </Compound>

    <Compound ref="robot type"/>

    <Compound name="location">
      <Compound name="Field2026-S"/>
    </Compound>
  </Scene>
</Simulation>
