#!/bin/bash
# downloads all autocalibration files from the robot.
# Usually the robot's HEADNAME and BODYNAME are the same, but they can be
# be different if a head was moved onto another body.
# The files of interest are:
# - Config/Robots/HEADNAME/BODYNAME/cameraCalibration.cfg
# - Config/Robots/BODYNAME/Body/footSoleRotationCalibration.cfg
# - Config/Robots/BODYNAME/Body/imuCalibration.cfg


usage()
{
  echo "usage: downloadAutoCalibrationFiles [-h | --help] <robotName> [<robotBodyName]"
  echo ""
  echo " -h or --help   display this usage"
  echo ""
  echo "  <robotName> is the name of the robot (or strictly speaking the name of the robot's head)."
  echo "        A robot name with no suffix resolves to the robot\'s LAN IP address."
  echo "        A robot name with a .wlan or .wifi suffix resolves to the robot\'s WLAN IP address."
  echo "  <robotBodyName> is optional and should only be added if the robot body name differs from"
  echo "        the robot head name. Do not use any suffix with the robotBodyName."
  echo ""
  echo "  examples:"
  echo "    Make/Linux/downloadAutoCalibrationFiles robby"
  echo "    Make/Linux/downloadAutoCalibrationFiles robby.wifi"
  echo "    Make/Linux/downloadAutoCalibrationFiles conn danu"
  exit 1
}

#Variables
BASEPATH=$(cd "$(dirname "$(which "$0")")" && pwd)

ROBOT_CONFIGPATH="/home/nao/Config/Robots"
LOCAL_CONFIGPATH="${BASEPATH}/../../Config/Robots"

KEYSOURCE="${BASEPATH}/../../Install/Keys/id_rsa_nao"
KEYFILE=/tmp/id_rsa_nao
cp -n "${KEYSOURCE}" ${KEYFILE}
SSHOPTIONS="-c aes128-ctr -i ${KEYFILE} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=quiet"


chmod 600 $KEYFILE

# only 1 or 2 cmd line args allowed
if [ $# -lt 1 ]; then
  usage
elif [ $# -gt 2 ]; then
  usage
fi

# process flags/options if any
while true; do
  case $1 in
    "-h" | "--help")
      usage
      ;;
    *)
      break
      ;;
  esac
done

# process positional arguments

if [ $# -ge 1 ]; then
  IP=`${BASEPATH}/../Common/resolveIp $1`
  ROBOTNAME=`echo $1 | sed "s%\.\(wlan\|wifi\)$%%"`

  echo "downloading autocalibration files from robot '${ROBOTNAME}' with address $IP"
fi

if [ $# -eq 2 ]; then
  BODYNAME=$2

  echo "using body name '${BODYNAME}' that differs from robot head name"
else
  BODYNAME=ROBOTNAME
fi


mkdir -p "$LOCAL_CONFIGPATH/${ROBOTNAME}/${ROBOTNAME}/"
mkdir -p "$LOCAL_CONFIGPATH/${BODYNAME}/Body/"

scp $sshoptions -p nao@$IP:$ROBOT_CONFIGPATH/${ROBOTNAME}/${BODYNAME}/cameraCalibration.cfg "$LOCAL_CONFIGPATH/${ROBOTNAME}/${BODYNAME}/"
scp $sshoptions -p nao@$IP:$ROBOT_CONFIGPATH/${BODYNAME}/Body/footSoleRotationCalibration.cfg "$LOCAL_CONFIGPATH/${BODYNAME}/Body/"
scp $sshoptions -p nao@$IP:$ROBOT_CONFIGPATH/${BODYNAME}/Body/imuCalibration.cfg "$LOCAL_CONFIGPATH/${BODYNAME}/Body/"

echo done
